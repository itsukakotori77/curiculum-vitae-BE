// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("NEST_DATABASE_URL")
}

model User {
  id             BigInt   @id @default(autoincrement())
  email          String   @unique
  name           String
  username       String   @unique
  password       String
  remember_token String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  CVitae CVitae[]

  @@map("user")
}

model CVitae {
  id                BigInt   @id @default(autoincrement())
  user_id           BigInt
  cvitae_setting_id BigInt
  name              String
  email             String
  phone             String
  address           String   @db.VarChar(255)
  summary           String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user             User               @relation(fields: [user_id], references: [id])
  CVitaeEducation  CVitaeEducation[]
  CVitaeExperience CVitaeExperience[]
  CVitaeSkill      CVitaeSkill[]
  CVitaeTemplate   CVitaeTemplate[]
  CVSetting        CVSetting?         @relation(fields: [cvitae_setting_id], references: [id])

  @@map("curiculum_vitae")
}

model CVitaeEducation {
  id         BigInt    @id @default(autoincrement())
  cvitae_id  BigInt
  school     String
  degree     String
  start_date DateTime? @default(now())
  end_date   DateTime? @default(now())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  cvitae CVitae @relation(fields: [cvitae_id], references: [id])

  @@map("curiculum_vitae_education")
}

model CVitaeExperience {
  id         BigInt    @id @default(autoincrement())
  cvitae_id  BigInt
  company    String
  position   String
  start_date DateTime? @default(now())
  end_date   DateTime? @default(now())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  cvitae CVitae @relation(fields: [cvitae_id], references: [id])

  @@map("curiculum_vitae_experience")
}

model CVitaeSkill {
  id         BigInt   @id @default(autoincrement())
  cvitae_id  BigInt
  skill      String
  level      Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cvitae CVitae @relation(fields: [cvitae_id], references: [id])

  @@map("curiculum_vitae_skill")
}

model CVitaeTemplate {
  id         BigInt   @id @default(autoincrement())
  name       String
  cvitae_id  BigInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cvitae CVitae @relation(fields: [cvitae_id], references: [id])

  @@map("curiculum_vitae_template")
}

model CVSetting {
  id            BigInt   @id @default(autoincrement())
  primary_color String?
  sidebar_color String?
  skill_color   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  CVitae CVitae[]

  @@map("curiculum_vitae_setting")
}

model FileItem {
  id         BigInt   @id @default(autoincrement())
  url        String
  public_id  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("file_item")
}
