// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  output          = "../src/generated/prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  // url      = env("NEST_DATABASE_URL")
}

model User {
  id             BigInt   @id @default(autoincrement())
  email          String   @unique
  name           String
  username       String   @unique
  password       String
  remember_token String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  CVitae CVitae[]

  @@map("user")
}

model CVitae {
  id                BigInt   @id @default(autoincrement())
  user_id           BigInt
  cvitae_setting_id BigInt
  name              String
  email             String
  phone             String
  address           String   @db.VarChar(255)
  summary           String   @db.LongText
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user             User               @relation(fields: [user_id], references: [id])
  CVitaeEducation  CVitaeEducation[]
  CVitaeExperience CVitaeExperience[]
  CVitaeSkill      CVitaeSkill[]
  templates        CVitaeOnTemplate[]
  CVSetting        CVSetting?         @relation(fields: [cvitae_setting_id], references: [id])
  fileCurs         FileCurr[]

  @@map("curiculum_vitae")
}

model CVitaeEducation {
  id         BigInt    @id @default(autoincrement())
  cvitae_id  BigInt
  school     String
  degree     String
  start_date DateTime? @default(now())
  end_date   DateTime? @default(now())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  cvitae CVitae @relation(fields: [cvitae_id], references: [id])

  @@map("curiculum_vitae_education")
}

model CVitaeExperience {
  id         BigInt    @id @default(autoincrement())
  cvitae_id  BigInt
  company    String
  position   String
  start_date DateTime? @default(now())
  end_date   DateTime? @default(now())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  cvitae CVitae @relation(fields: [cvitae_id], references: [id])

  @@map("curiculum_vitae_experience")
}

model CVitaeSkill {
  id         BigInt   @id @default(autoincrement())
  cvitae_id  BigInt
  skill      String
  level      Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cvitae CVitae @relation(fields: [cvitae_id], references: [id])

  @@map("curiculum_vitae_skill")
}

model CVitaeTemplate {
  id               BigInt              @id @default(autoincrement())
  name             String
  type             CVitaeTemplateType? @default(MODERN)
  is_photo         Boolean?
  template_photo   String?
  template_nophoto String?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  cvitaes CVitaeOnTemplate[]

  @@map("curiculum_vitae_template")
}

model CVitaeOnTemplate {
  cvitae_id          BigInt
  cvitae_template_id BigInt
  assigned_at        DateTime @default(now())

  cvitae   CVitae         @relation(fields: [cvitae_id], references: [id], onDelete: Cascade)
  template CVitaeTemplate @relation(fields: [cvitae_template_id], references: [id], onDelete: Cascade)

  @@id([cvitae_id, cvitae_template_id])
  @@map("curiculum_vitae_on_template")
}

model CVSetting {
  id             BigInt   @id @default(autoincrement())
  primary_color  String?
  sidebar_color  String?
  skill_color    String?
  is_using_photo Int?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  CVitae CVitae[]

  @@map("curiculum_vitae_setting")
}

model FileItem {
  id         BigInt   @id @default(autoincrement())
  url        String
  public_id  String
  filename   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fileCurrs FileCurr[]

  @@map("file_item")
}

model FileCurr {
  id         BigInt   @id @default(autoincrement())
  cvtae_id   BigInt
  file_id    BigInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cvtae    CVitae   @relation(fields: [cvtae_id], references: [id], onDelete: Cascade)
  fileItem FileItem @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@unique([cvtae_id, file_id])
  @@map("file_curr")
}

enum CVitaeTemplateType {
  ATS
  MODERN
}
